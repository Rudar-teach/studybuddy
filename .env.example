# ===== Firebase (Firestore data layer) =====
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ===== Admin (server-side only, NEVER exposed to the browser) =====
# Comma-separated list of secret tokens. Send one in the X-Admin-Key
# header to access /api/admin. Generate with: openssl rand -hex 32
ADMIN_KEYS=change-me-to-a-strong-secret
